# Copy this file to .env and fill in real values before running the server.

# --- Server ---
PORT=4000
# Local dev: http://localhost:5173
# Deployed: the exact URL of your deployed frontend, e.g. https://jn-venture-os.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# --- Database ---
# Either set DATABASE_URL (preferred for hosted Postgres / docker-compose)...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jn_venture_os

# Set to true when DATABASE_URL points at a hosted provider (Neon, Render
# Postgres, Supabase, etc). Leave unset/false for local Docker Postgres.
DB_SSL=false

# ...or set discrete vars instead and leave DATABASE_URL blank:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=jn_venture_os
