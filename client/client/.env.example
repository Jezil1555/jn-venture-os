# Local dev: leave both of these unset. Vite proxies /api to localhost:4000.

# Only needed if your local API isn't running on the default proxy target.
# VITE_API_PROXY_TARGET=http://localhost:4000

# Production build only: the full URL of your deployed backend's API.
# e.g. https://jn-venture-os-api.onrender.com/api
# VITE_API_BASE_URL=
